{
  "manifest_version": 3,
  "name": "Label Snip",
  "version": "1.1.0",
  "description": "Trims shipping label PDFs to a print-ready 4x6. Runs entirely on your computer.",
  "homepage_url": "https://github.com/cmjdev-25/label-snip",
  "action": {
    "default_title": "Snip this label to 4x6",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://svc-shipping-labels.s3.eu-central-1.amazonaws.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
